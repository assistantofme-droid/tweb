{
    "name": "7eve9Chat",
    "short_name": "7eve9Chat",
    "id": "/k/",
    "start_url": "./",
    "scope": "./",
    "scope_extensions": [
        {
            "type": "origin",
            "origin": "https://7eve9craft.ir"
        }
    ],
    "description": "7eve9Chat is a fast and secure messaging app.",
    "icons": [
        {
            "src": "assets/img/icon_square_192.png?v=jw3mK7G9Ry",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "assets/img/icon_square_384.png?v=jw3mK7G9Ry",
            "sizes": "384x384",
            "type": "image/png"
        },
        {
            "src": "assets/img/icon_square_512.png?v=jw3mK7G9Ry",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "screenshots" : [{
        "src": "assets/img/screenshot.jpg",
        "sizes": "1280x910",
        "type": "image/jpeg"
    }],
    "share_target": {
        "action": "./share/",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [{
                "name": "files",
                "accept": "*/*"
            }]
        }
    },
    "theme_color": "#fffffe",
    "background_color": "#ffffff",
    "display": "standalone"
}
